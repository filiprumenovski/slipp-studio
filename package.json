{
  "name": "slipp-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "node --experimental-strip-types scripts/check-view-options.mjs && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:contacts": "esbuild scripts/check-contacts.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/slipp-contact-check.cjs && node node_modules/.cache/slipp-contact-check.cjs",
    "test:workbench": ".venv-docking/bin/python scripts/check-workbench.py",
    "test:anatomy": "esbuild scripts/check-anatomy.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/slipp-anatomy-check.cjs && node node_modules/.cache/slipp-anatomy-check.cjs",
    "test:inference": ".venv-docking/bin/python scripts/check-inference.py",
    "test:workspace": "esbuild scripts/check-workspace.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/slipp-workspace-check.cjs && node node_modules/.cache/slipp-workspace-check.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "lucide-react": "^1.47.0",
    "molstar": "^5.11.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
